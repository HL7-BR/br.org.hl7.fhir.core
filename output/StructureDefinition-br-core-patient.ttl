           fhir:value [ fhir:v "Language" ]
         ] ) ;
         fhir:strength [ fhir:v "preferred" ] ;
         fhir:description [ fhir:v "A human language." ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/languages"^^xsd:anyURI ;
