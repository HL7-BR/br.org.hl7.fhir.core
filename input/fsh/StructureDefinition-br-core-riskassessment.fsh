Profile: BRCoreRiskAssessment
Parent: http://hl7.org/fhir/StructureDefinition/RiskAssessment
Id: br-core-riskassessment
Title: "BR Core RiskAssessment"
Description: "Este perfil representa as restrições aplicadas ao recurso FHIR R4 [RiskAssessment](http://hl7.org/fhir/R4/riskassessment.html), usado para registrar a avaliação do risco de um desfecho para o paciente."

* id ^short = "Identificador lógico deste artefato"
* id ^definition = "Identificador lógico deste artefato"
* meta ^short = "Metadados sobre o recurso"
* meta ^definition = "Metadados sobre o recurso"
* implicitRules ^short = "Um conjunto de regras sob as quais este conteúdo foi criado"
* implicitRules ^definition = "Um conjunto de regras sob as quais este conteúdo foi criado"
* language ^short = "Idioma do recurso"
* language ^definition = "Idioma do recurso"
* text ^short = "Resumo do texto do recurso em linguagem natural"
* text ^definition = "Resumo do texto do recurso em linguagem natural"
* contained ^short = "Recursos contidos no recurso"
* contained ^definition = "Recursos contidos no recurso"
* extension ^short = "Extensões adicionais que não fazem parte do modelo base"
* extension ^definition = "Extensões adicionais que não fazem parte do modelo base"
* modifierExtension ^short = "Extensões adicionais que não podem ser ignoradas, mesmo que não reconhecidas"
* modifierExtension ^definition = "Extensões adicionais que não podem ser ignoradas, mesmo que não reconhecidas"
* identifier ^short = "Identificadores externos para esta avaliação de risco"
* identifier ^definition = "Identificadores externos para esta avaliação de risco"
* basedOn ^short = "Solicitação que motivou esta avaliação de risco"
* basedOn ^definition = "Solicitação que motivou esta avaliação de risco"
* parent ^short = "Avaliação de risco ou outro recurso do qual esta avaliação faz parte"
* parent ^definition = "Avaliação de risco ou outro recurso do qual esta avaliação faz parte"
* status ^short = "Status da avaliação de risco: registered | preliminary | final | amended | corrected | cancelled | entered-in-error | unknown"
* status ^definition = "Status da avaliação de risco: registered | preliminary | final | amended | corrected | cancelled | entered-in-error | unknown"
* method ^short = "Método, escore ou instrumento usado para avaliar o risco"
* method ^definition = "Algoritmo, processo, escore ou instrumento usado para avaliar a probabilidade do desfecho"
* code ^short = "Tipo de avaliação de risco realizada"
* code ^definition = "Tipo de avaliação de risco realizada"
* subject ^short = "Paciente ou grupo cujo risco está sendo avaliado"
* subject ^definition = "Referência ao paciente ou ao grupo cujo risco está sendo avaliado"
* subject only Reference(br-core-patient or Group)
* subject.id ^short = "Identificador único para referência cruzada"
* subject.id ^definition = "Identificador único para referência cruzada"
* subject.extension ^short = "Extensões adicionais que não fazem parte do modelo de dados básico"
* subject.extension ^definition = "Extensões adicionais que não fazem parte do modelo de dados básico"
* subject.reference ^short = "Referência literal. URL relativa, interna ou externa"
* subject.reference ^definition = "Referência literal. URL relativa, interna ou externa"
* subject.type ^short = "Tipo de recurso ao qual a referência é feita"
* subject.type ^definition = "Tipo de recurso ao qual a referência é feita"
* subject.identifier ^short = "Referência lógica, quando a referência literal não é conhecida"
* subject.identifier ^definition = "Referência lógica, quando a referência literal não é conhecida"
* subject.display ^short = "Texto alternativo para o recurso"
* subject.display ^definition = "Texto alternativo para o recurso"
* encounter ^short = "Atendimento no qual a avaliação de risco foi feita"
* encounter ^definition = "Referência ao atendimento no qual a avaliação de risco foi feita"
* encounter only Reference(br-core-encounter)
* occurrence[x] ^short = "Data ou período em que a avaliação foi feita"
* occurrence[x] ^definition = "Data ou período em que a avaliação de risco foi feita"
* condition ^short = "Condição de saúde que está sendo avaliada"
* condition ^definition = "Referência à condição de saúde cujo risco de desfecho está sendo avaliado"
* condition only Reference(br-core-condition)
* performer ^short = "Profissional ou dispositivo que realizou a avaliação"
* performer ^definition = "Profissional de saúde, papel profissional ou dispositivo que realizou a avaliação de risco"
* performer only Reference(br-core-practitioner or br-core-practitionerrole or Device)
* reasonCode ^short = "Motivo da avaliação de risco"
* reasonCode ^definition = "Motivo da avaliação de risco"
* reasonReference ^short = "Referência ao motivo da avaliação de risco"
* reasonReference ^definition = "Condição, observação, laudo ou documento que justifica a avaliação de risco"
* reasonReference only Reference(br-core-condition or br-core-observation or br-core-diagnosticreport or DocumentReference)
* basis ^short = "Informações usadas na avaliação"
* basis ^definition = "Informações (por exemplo, histórico familiar, observações, exames) usadas na avaliação de risco"
* prediction ^short = "Desfecho previsto"
* prediction ^definition = "Desfecho previsto e a probabilidade de que ocorra"
* prediction.id ^short = "Identificador único para referência cruzada"
* prediction.id ^definition = "Identificador único para referência cruzada"
* prediction.extension ^short = "Extensões adicionais que não fazem parte do modelo de dados básico"
* prediction.extension ^definition = "Extensões adicionais que não fazem parte do modelo de dados básico"
* prediction.modifierExtension ^short = "Extensões adicionais que não podem ser ignoradas, mesmo que não reconhecidas"
* prediction.modifierExtension ^definition = "Extensões adicionais que não podem ser ignoradas, mesmo que não reconhecidas"
* prediction.outcome ^short = "Desfecho possível para o paciente"
* prediction.outcome ^definition = "Desfecho possível para o paciente (por exemplo, remissão, óbito, uma condição específica)"
* prediction.probability[x] ^short = "Probabilidade do desfecho, em percentual ou faixa"
* prediction.probability[x] ^definition = "Probabilidade do desfecho, expressa como decimal ou faixa"
* prediction.qualitativeRisk ^short = "Probabilidade qualitativa do desfecho: negligible | low | moderate | high | certain"
* prediction.qualitativeRisk ^definition = "Expressão qualitativa da probabilidade do desfecho (por exemplo, baixa, moderada, alta)"
* prediction.qualitativeRisk from http://hl7.org/fhir/ValueSet/risk-probability (example)
* prediction.relativeRisk ^short = "Risco relativo"
* prediction.relativeRisk ^definition = "Risco relativo do desfecho em comparação com a população de referência"
* prediction.when[x] ^short = "Período ou faixa etária em que o desfecho é esperado"
* prediction.when[x] ^definition = "Período de tempo ou faixa etária em que se espera que o desfecho ocorra"
* prediction.rationale ^short = "Justificativa da previsão"
* prediction.rationale ^definition = "Informações adicionais que explicam a base da previsão"
* mitigation ^short = "Como reduzir o risco"
* mitigation ^definition = "Descrição das ações que podem reduzir a probabilidade do desfecho"
* note ^short = "Informações adicionais sobre a avaliação de risco"
* note ^definition = "Informações adicionais sobre a avaliação de risco"
