Instance: rms
InstanceOf: NamingSystem
Usage: #definition
Title: "RMS - Registro Único do Ministério da Saúde"
Description: "Registro Único para o exercício da medicina (RMS), emitido pelo Ministério da Saúde ao médico intercambista do Projeto Mais Médicos para o Brasil (Lei nº 12.871/2013, art. 16, § 3º; Portaria GM/MS nº 2.477/2013)."
* name = "NamingSystemRMS"
* status = #active
* kind = #identifier
* date = "2026-11-24"
* publisher = "Ministério da Saúde do Brasil"
* responsible = "Ministério da Saúde, Projeto Mais Médicos para o Brasil"
* jurisdiction = urn:iso:std:iso:3166#BR "Brazil"
* usage = "Identifica o médico intercambista só no âmbito do Projeto Mais Médicos, enquanto ele estiver no programa. Número de 7 dígitos (código IBGE da UF, 0 e 4 dígitos), publicado no DOU. Use com o CPF ou o CNS: o RMS não substitui a identificação da pessoa."
* uniqueId[0].type = #uri
* uniqueId[0].value = "https://saude.gov.br/fhir/sid/rms"
* uniqueId[0].preferred = true
